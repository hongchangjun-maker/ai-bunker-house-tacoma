{
  "name": "ai-bunker-house-tacoma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler pages dev dist --d1 DB=ai-bunker-tacoma-db",
    "cf:deploy": "wrangler pages deploy dist --project-name ai-bunker-house-tacoma",
    "cf:dry": "wrangler pages functions build --outdir .wrangler/functions-build"
  },
  "dependencies": {
    "framer-motion": "13.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
